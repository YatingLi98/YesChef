/**app.wxss**/
page {
  background-color: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
}

/* 容器 */
.container {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

.page-container {
  padding: 30rpx;
}

/* 布局 */
.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  align-items: center;
  justify-content: center;
}

.flex-between {
  justify-content: space-between;
  align-items: center;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* 文字样式 */
.text-center {
  text-align: center;
}

.text-primary {
  color: #ff6b6b;
}

.text-success {
  color: #51cf66;
}

.text-warning {
  color: #ffd43b;
}

.text-secondary {
  color: #666;
}

.text-muted {
  color: #999;
}

.text-white {
  color: #fff;
}

.text-bold {
  font-weight: bold;
}

.text-large {
  font-size: 36rpx;
}

.text-small {
  font-size: 24rpx;
}

/* 间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mt-40 { margin-top: 40rpx; }

.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.mb-40 { margin-bottom: 40rpx; }

.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }

.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }

.p-10 { padding: 10rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

.px-20 { padding-left: 20rpx; padding-right: 20rpx; }
.py-20 { padding-top: 20rpx; padding-bottom: 20rpx; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

/* 按钮 */
.btn {
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8787 100%);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-success {
  background: linear-gradient(135deg, #51cf66 0%, #69db7c 100%);
  color: #fff;
}

.btn-outline {
  background: #fff;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
}

.btn-block {
  width: 100%;
  display: block;
}

.btn-large {
  padding: 30rpx 60rpx;
  font-size: 32rpx;
}

.btn-small {
  padding: 16rpx 32rpx;
  font-size: 24rpx;
}

/* 输入框 */
.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.input-field {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
}

.input-field:focus {
  border-color: #ff6b6b;
}

/* 徽章 */
.badge {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1;
}

.badge-primary {
  background: #ff6b6b;
  color: #fff;
}

.badge-success {
  background: #51cf66;
  color: #fff;
}

.badge-warning {
  background: #ffd43b;
  color: #333;
}

.badge-secondary {
  background: #e9ecef;
  color: #666;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #e9ecef;
  margin: 30rpx 0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

/* 图片样式 */
.food-image {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  object-fit: cover;
}

/* 列表 */
.list-item {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  background: #f1f3f5;
  color: #666;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

/* 统计卡片 */
.stat-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
}