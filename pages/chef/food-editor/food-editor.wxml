<!--pages/chef/food-editor/food-editor.wxml-->
<view class="page-container">
  <view class="form-section">
    <view class="input-group">
      <text class="input-label">Dish Name *</text>
      <input 
        class="input-field" 
        placeholder="Enter dish name" 
        value="{{name}}"
        bindinput="onNameInput"
      />
    </view>

    <view class="input-group">
      <text class="input-label">Description *</text>
      <textarea 
        class="textarea-field" 
        placeholder="Describe your dish" 
        value="{{description}}"
        bindinput="onDescriptionInput"
        maxlength="500"
        show-confirm-bar="{{false}}"
      />
    </view>

    <view class="input-group">
      <text class="input-label">Cooking Instructions *</text>
      <textarea 
        class="textarea-field instruction-field" 
        placeholder="Step-by-step cooking instructions..." 
        value="{{instructions}}"
        bindinput="onInstructionsInput"
        maxlength="2000"
        show-confirm-bar="{{false}}"
      />
    </view>

    <view class="input-group">
      <text class="input-label">Tags (comma separated)</text>
      <input 
        class="input-field" 
        placeholder="e.g., Chinese, Spicy, Vegetarian" 
        value="{{tagsStr}}"
        bindinput="onTagsInput"
      />
      <view class="tags-preview" wx:if="{{tags.length > 0}}">
        <text class="tag" wx:for="{{tags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="input-group">
      <text class="input-label">Images</text>
      <view class="image-upload-section">
        <view class="image-list">
          <view class="image-item" wx:for="{{images}}" wx:key="*this">
            <image src="{{item}}" class="preview-image" mode="aspectFill"></image>
            <view class="image-remove" bindtap="onRemoveImage" data-index="{{index}}">×</view>
          </view>
          <view class="image-add-btn" bindtap="onAddImage" wx:if="{{images.length < 5}}">
            <text class="add-icon">+</text>
            <text class="add-text">Add Image</text>
          </view>
        </view>
        <text class="helper-text">Up to 5 images. Tap to add image URL.</text>
      </view>
    </view>

    <view class="button-group">
      <button class="btn btn-primary btn-block btn-large" bindtap="onSave">
        {{isEdit ? 'Update Dish' : 'Create Dish'}}
      </button>
      <button class="btn btn-outline btn-block mt-20" bindtap="onCancel">
        Cancel
      </button>
    </view>
  </view>
</view>