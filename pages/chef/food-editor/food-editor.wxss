/* pages/chef/food-editor/food-editor.wxss */
.form-section {
  padding-bottom: 40rpx;
}

.textarea-field {
  width: 100%;
  min-height: 150rpx;
  padding: 24rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
}

.instruction-field {
  min-height: 250rpx;
}

.tags-preview {
  margin-top: 15rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.image-upload-section {
  margin-top: 10rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  object-fit: cover;
}

.image-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 50rpx;
  height: 50rpx;
  background: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 79, 0.3);
}

.image-add-btn {
  width: 200rpx;
  height: 200rpx;
  border: 3rpx dashed #d9d9d9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.add-icon {
  font-size: 48rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

.helper-text {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 15rpx;
}

.button-group {
  margin-top: 40rpx;
}