/* pages/chef/menu-manager/menu-manager.wxss */
.header {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8787 100%);
  padding: 30rpx;
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 30rpx;
}

.header-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.header-text {
  flex: 1;
  margin-left: 20rpx;
}

.welcome-text {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.role-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}

.header-actions {
  display: flex;
  justify-content: flex-end;
}

.stats-section {
  display: flex;
  gap: 20rpx;
  padding: 0 20rpx;
  margin-bottom: 30rpx;
}

.action-section {
  padding: 0 20rpx;
  margin-bottom: 40rpx;
}

.food-list-section {
  padding: 0 20rpx;
}

.section-title {
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.food-list {
  margin-bottom: 40rpx;
}

.food-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.food-card-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}

.food-card-content {
  padding: 24rpx;
}

.food-card-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.food-card-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 1.6;
}

.food-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
}

.food-tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.food-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  font-size: 24rpx;
  color: #ff6b6b;
  padding: 10rpx 0;
}