/* pages/chef/orders/orders.wxss */
.header {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8787 100%);
  padding: 40rpx 30rpx;
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.tabs {
  display: flex;
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8787 100%);
  color: #fff;
  font-weight: bold;
}

.order-list {
  padding: 0 20rpx 40rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-info {
  flex: 1;
}

.order-id {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.order-time {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.order-customer {
  margin-bottom: 20rpx;
  padding: 15rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.customer-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 10rpx;
}

.customer-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.order-items {
  margin-bottom: 20rpx;
}

.order-item {
  padding: 15rpx 0;
  border-bottom: 1rpx dashed #e9ecef;
}

.order-item:last-child {
  border-bottom: none;
}

.item-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-quantity {
  font-size: 26rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.order-note {
  padding: 15rpx;
  background: #fff9e6;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.note-label {
  font-size: 24rpx;
  color: #faad14;
  margin-right: 10rpx;
  font-weight: bold;
}

.note-text {
  font-size: 26rpx;
  color: #666;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}