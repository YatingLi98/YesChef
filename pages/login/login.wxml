<!--pages/login/login.wxml-->
<view class="login-container">
  <view class="login-header">
    <text class="login-title">🍔 Food Ordering</text>
    <text class="login-subtitle">Order delicious food with friends</text>
  </view>

  <view class="login-form">
    <view class="welcome-text">
      <text class="welcome-title">Welcome!</text>
      <text class="welcome-desc">Login with your WeChat account to get started</text>
    </view>

    <button
      class="btn btn-success btn-block btn-large wechat-login-btn"
      bindtap="onWeChatLogin"
    >
      <text class="wechat-icon">💬</text> Login with WeChat
    </button>

    <view class="features-info">
      <text class="feature-title">What you can do:</text>
      <view class="feature-item">
        <text class="feature-icon">👨‍🍳</text>
        <text class="feature-text">As Chef: Create menu, manage orders</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">🍽️</text>
        <text class="feature-text">As Diner: Browse menu, place orders</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">🔄</text>
        <text class="feature-text">Switch roles anytime!</text>
      </view>
    </view>
  </view>
</view>