/* pages/eater/order-history/order-history.wxss */
.header {
  background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
  padding: 40rpx 30rpx;
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.order-list {
  padding: 0 20rpx 40rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-id {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.order-time {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.order-chef {
  margin-bottom: 20rpx;
  padding: 15rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.label {
  font-size: 24rpx;
  color: #666;
  margin-right: 10rpx;
}

.value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.order-items {
  margin-bottom: 15rpx;
}

.item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #e9ecef;
}

.item:last-child {
  border-bottom: none;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-qty {
  font-size: 26rpx;
  color: #51cf66;
  font-weight: bold;
}

.order-note {
  padding: 15rpx;
  background: #fff9e6;
  border-radius: 8rpx;
  margin-top: 15rpx;
}

.note-label {
  font-size: 24rpx;
  color: #faad14;
  margin-right: 10rpx;
  font-weight: bold;
}

.note-text {
  font-size: 26rpx;
  color: #666;
}