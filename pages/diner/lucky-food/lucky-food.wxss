/* pages/eater/lucky-food/lucky-food.wxss */
.header {
  background: linear-gradient(135deg, #ffd43b 0%, #fab005 100%);
  padding: 40rpx 30rpx;
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.lucky-wheel-section {
  padding: 40rpx 30rpx;
}

.wheel-container {
  width: 300rpx;
  height: 300rpx;
  margin: 0 auto 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: transform 0.3s;
}

.wheel-container.spinning {
  animation: spin 2s ease-in-out;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1080deg); }
}

.wheel-inner {
  width: 240rpx;
  height: 240rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wheel-icon {
  font-size: 100rpx;
}

.result-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.result-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.food-result {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.result-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  object-fit: cover;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.result-chef {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 15rpx;
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.instruction-card {
  background: linear-gradient(135deg, #fff9e6 0%, #fff3bf 100%);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.instruction-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.instruction-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.action-section {
  padding: 0 30rpx;
  margin-bottom: 40rpx;
}

.spin-btn {
  font-size: 32rpx;
  font-weight: bold;
}

.tip-text {
  text-align: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.history-section {
  padding: 0 30rpx 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.history-list {
  display: flex;
  gap: 15rpx;
  overflow-x: auto;
}

.history-item {
  flex-shrink: 0;
  width: 160rpx;
}

.history-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  object-fit: cover;
  margin-bottom: 10rpx;
}

.history-name {
  display: block;
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}