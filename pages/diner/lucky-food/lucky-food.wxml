<!--pages/eater/lucky-food/lucky-food.wxml-->
<view class="container">
  <role-switcher />
  
  <view class="header">
    <text class="header-title">🎲 Lucky Food Suggester</text>
    <text class="header-subtitle">Let fate decide your meal!</text>
  </view>

  <view class="lucky-wheel-section">
    <view class="wheel-container {{spinning ? 'spinning' : ''}}">
      <view class="wheel-inner">
        <text class="wheel-icon">{{luckyFood ? '🎯' : '🍔'}}</text>
      </view>
    </view>

    <view wx:if="{{luckyFood}}" class="result-card">
      <text class="result-title">Your Lucky Food:</text>
      <view class="food-result">
        <image src="{{luckyFood.images[0]}}" class="result-image" mode="aspectFill"></image>
        <view class="result-info">
          <text class="result-name">{{luckyFood.name}}</text>
          <text class="result-chef">by {{luckyFood.chefName}}</text>
          <view class="result-tags">
            <text class="tag" wx:for="{{luckyFood.tags}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
      </view>
      <view class="result-actions">
        <button class="btn btn-success btn-block" bindtap="onAddLuckyFood">
          Add to Cart
        </button>
        <button class="btn btn-outline btn-block mt-20" bindtap="onViewDetails">
          View Details
        </button>
      </view>
    </view>

    <view wx:else class="instruction-card">
      <text class="instruction-icon">✨</text>
      <text class="instruction-text">
        Feeling indecisive? Let our lucky wheel pick the perfect dish for you!
      </text>
    </view>
  </view>

  <view class="action-section">
    <button 
      class="btn btn-primary btn-large btn-block spin-btn" 
      bindtap="onSpin"
      disabled="{{spinning || !hasChef}}"
    >
      {{spinning ? '🎰 Spinning...' : '🎲 Spin the Wheel!'}}
    </button>

    <view wx:if="{{!hasChef}}" class="tip-text">
      <text>Please select a chef from the Menu tab first</text>
    </view>
  </view>

  <view class="history-section" wx:if="{{history.length > 0}}">
    <text class="section-title">Recent Lucky Foods</text>
    <view class="history-list">
      <view class="history-item" wx:for="{{history}}" wx:key="id">
        <image src="{{item.images[0]}}" class="history-image" mode="aspectFill"></image>
        <text class="history-name">{{item.name}}</text>
      </view>
    </view>
  </view>
</view>