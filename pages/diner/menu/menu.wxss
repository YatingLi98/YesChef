/* pages/eater/menu/menu.wxss */
.header {
  background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
  padding: 40rpx 30rpx;
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-content {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.chef-selector {
  background: #fff;
  padding: 24rpx 30rpx;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.chef-info {
  flex: 1;
}

.chef-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.chef-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.change-chef {
  font-size: 26rpx;
  color: #51cf66;
  padding: 10rpx 20rpx;
}

.cart-summary {
  background: linear-gradient(135deg, #ffd43b 0%, #fab005 100%);
  padding: 24rpx 30rpx;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 212, 59, 0.3);
}

.cart-info {
  display: flex;
  align-items: center;
}

.cart-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.cart-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.food-grid {
  padding: 0 20rpx 40rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.food-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.food-item-image {
  width: 100%;
  height: 250rpx;
  object-fit: cover;
}

.food-item-content {
  padding: 20rpx;
}

.food-item-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-item-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
  height: 67rpx;
}

.food-item-tags {
  margin-bottom: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.food-item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.chef-badge {
  font-size: 22rpx;
  color: #999;
}

.btn-add {
  background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: none;
  line-height: 1;
}

.btn-add::after {
  border: none;
}