/* pages/register/register.wxss */
.register-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.register-header {
  text-align: center;
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.register-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 15rpx;
}

.register-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.register-form {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.role-selector {
  margin-bottom: 30rpx;
}

.role-options {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.role-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 25rpx 15rpx;
  border: 3rpx solid #e9ecef;
  border-radius: 16rpx;
  background: #fff;
  transition: all 0.3s;
}

.role-option.active {
  border-color: #ff6b6b;
  background: #fff5f5;
}

.role-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.role-text {
  font-size: 28rpx;
  color: #666;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.role-desc {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

.role-option.active .role-text {
  color: #ff6b6b;
}

.role-option.active .role-desc {
  color: #ff6b6b;
}

.register-footer {
  text-align: center;
  margin-top: 30rpx;
}

.footer-text {
  font-size: 26rpx;
  color: #666;
}

.footer-link {
  font-size: 26rpx;
  color: #ff6b6b;
  font-weight: bold;
}